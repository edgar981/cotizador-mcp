# Copy to .env.dev and fill in. Without COTIZADOR_COGNITO_POOL_ID the HTTP
# transport runs without auth, and only on 127.0.0.1.
COTIZADOR_PUBLIC_URL=http://localhost:8000
COTIZADOR_COGNITO_POOL_ID=us-east-2_XXXXXXXXX
COTIZADOR_COGNITO_DOMAIN=https://your-prefix.auth.us-east-2.amazoncognito.com
COTIZADOR_COGNITO_CLIENT_IDS=your-app-client-id
